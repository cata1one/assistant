# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Claude (необязательно). Без ключа ассистент работает офлайн.
ANTHROPIC_API_KEY=
# auto – использовать Claude, если есть ключ; on – всегда; off – только офлайн
TUTOR_LLM=auto
TUTOR_LLM_MODEL=claude-opus-5-5
# Серверный резерв на другую модель, если основная отклонит запрос
TUTOR_LLM_FALLBACKS=1

# --- Язык
TUTOR_TARGET_LANGUAGE=en
TUTOR_NATIVE_LANGUAGE=ru
TUTOR_TIMEZONE=Europe/Moscow

# --- Хранилище
TUTOR_DB_PATH=data/tutor_assistant.sqlite3

# --- Контроль контактов
# 1 – скрывать сообщения с контактами, 0 – только предупреждать
TUTOR_BLOCK_CONTACTS=1
# Официальные контакты школы, которые можно публиковать (через запятую)
TUTOR_ALLOWED_EMAILS=support@myschool.ru
TUTOR_ALLOWED_HANDLES=myschool_bot,myschool_support
TUTOR_ALLOWED_DOMAINS=myschool.ru
TUTOR_ALLOWED_PHONES=88005553535
# Окно (сек.), в котором номер, разбитый на несколько сообщений, склеивается
TUTOR_SPLIT_WINDOW_SECONDS=180
# Анонимный мост: пересылать фото, файлы и голосовые (их содержимое не проверяется автоматически).
# 0 – передавать только текст (максимальная защита).
TUTOR_RELAY_MEDIA=1

# --- Распознавание речи и запись урока (pip install -r requirements-speech.txt)
# auto – включить, если пакет установлен; on; off
TUTOR_STT=auto
# tiny | base | small | medium | large-v3: точнее – медленнее. small – хороший баланс для CPU
# TUTOR_STT_MODEL=small   # install.sh выбирает сам: small, а на мощном сервере (8+ ядер, 16+ ГБ) medium
# Пусто – язык определяется автоматически (урок обычно на двух языках)
TUTOR_STT_LANGUAGE=
TUTOR_STT_DEVICE=cpu
TUTOR_STT_COMPUTE_TYPE=int8
# Папка с моделью (для серверов без интернета скачайте модель заранее)
TUTOR_STT_MODEL_DIR=data/models
# Пересылать голосовые, если проверить речь не удалось (0 – не пересылать: безопаснее)
TUTOR_RELAY_UNCHECKED_AUDIO=0
# 1 – урок обязательно записывается: без записи или при перерыве администратор получит уведомление
TUTOR_REQUIRE_RECORDING=0
TUTOR_RECORDING_GAP_SECONDS=90
# Куда отправлять JSON о каждом нарушении (платформа школы, CRM). Пусто – не отправлять
TUTOR_ALERT_WEBHOOK_URL=

# --- Telegram-бот
TELEGRAM_BOT_TOKEN=
# Если бот пишет «Timed out» (api.telegram.org недоступен) – прокси или VPN.
# Примеры: http://127.0.0.1:10809  или  socks5://user:pass@host:1080 (для socks: pip install "httpx[socks]")
TELEGRAM_PROXY=
# Чат/канал администраторов школы для уведомлений о нарушениях (например -1001234567890)
TUTOR_ADMIN_CHAT_ID=
# Telegram id администраторов (через запятую) – создание пар /new_pair, /pairs, /unpair, /incidents
TUTOR_ADMIN_USER_IDS=

# --- HTTP API для платформы школы
TUTOR_API_TOKEN=change-me-to-a-long-random-string
TUTOR_API_HOST=127.0.0.1
TUTOR_API_PORT=8080

# --- Сайт школы (раздаётся тем же сервером: python -m tutor_assistant serve или api)
TUTOR_SCHOOL_NAME=Bright
# Публичный адрес сайта – для ссылок в личный кабинет (/cabinet в боте). Нужен https для кнопки в Telegram
# Для просмотра на своём компьютере: http://127.0.0.1:8080
TUTOR_SITE_URL=http://127.0.0.1:8080
# Имя бота школы без @ – кнопки «Чат в Telegram» и «Открыть бота» на сайте
TUTOR_BOT_USERNAME=myschool_bot
# Где проходят уроки: ссылки на класс принимаются только с этих доменов
TUTOR_CLASSROOM_DOMAINS=progressme.ru
# Срок действия ссылки в личный кабинет, дней
TUTOR_ACCESS_TOKEN_DAYS=30
# 1 – сайт за nginx/прокси: IP посетителя из X-Forwarded-For (защита формы заявки от спама)
TUTOR_TRUST_PROXY=0

# --- Онлайн-класс (видеоурок на сайте)
# JSON-список ICE-серверов. По умолчанию – публичные STUN; для учеников за строгим NAT/мобильным интернетом
# поставьте свой TURN (coturn) на сервер школы:
# TUTOR_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.myschool.ru:3478","username":"school","credential":"пароль"}]
TUTOR_ICE_SERVERS=

# --- Отзывы и биржа учеников
# 1 – показывать примеры отзывов с пометкой «пример», пока нет настоящих (выдуманные отзывы как настоящие
# публиковать нельзя: это нарушение закона о рекламе и прав потребителей)
TUTOR_DEMO_REVIEWS=0
# Комиссия школы с уроков учеников, найденных через биржу (показывается преподавателям), %
TUTOR_MARKET_FEE=20

# --- Почта: письма об оплате занятий, конспектах, ответы поддержки.
# Для Mail.ru: хост smtp.mail.ru, порт 465, пароль для внешнего приложения (Настройки почты → Пароли для внешних приложений).
# Без этих настроек письма не отправляются: уведомления остаются на сайте и в Telegram.
TUTOR_SMTP_HOST=
TUTOR_SMTP_PORT=465
TUTOR_SMTP_USER=
TUTOR_SMTP_PASSWORD=
# От чьего имени уходят письма (по умолчанию как TUTOR_SMTP_USER)
TUTOR_SMTP_FROM=
# Куда приходят обращения из окна помощи
TUTOR_SUPPORT_EMAIL=monework@mail.ru

# --- Оплата тарифа через ЮKassa (карта, СБП). Пока не заполнено, оплата отключена, доступ продлевает администратор.
# Магазин создаётся в личном кабинете ЮKassa; адрес уведомлений: https://ВАШ-ДОМЕН/site/v1/pay/yookassa (событие payment.succeeded)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 – отправлять чек вместе с платежом (54-ФЗ). Нужно, если в ЮKassa не подключены чеки от ЮKassa
YOOKASSA_RECEIPT=0
YOOKASSA_TAX_SYSTEM=0
YOOKASSA_VAT_CODE=1
